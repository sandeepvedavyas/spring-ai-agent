# Local demo credential. This is not a secret. Set a unique AGENT_API_KEY
# before the process is reachable from anywhere but your machine.
AGENT_API_KEY=local-dev-key

# OpenAI-compatible chat origin. Spring AI appends /v1/chat/completions.
# A value that already ends in /v1 is accepted and is not doubled.
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30s

# Sibling gateway (https://github.com/sandeepvedavyas/llm-api-gateway).
# Run the gateway on 8081 and point this process at its origin:
# OPENAI_BASE_URL=http://localhost:8081
# OPENAI_API_KEY=<gateway caller key>
# OPENAI_MODEL=gpt-4o-mini

SERVER_PORT=8080
